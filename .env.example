# Copy to .env and edit. Every value here is optional; the defaults below are
# what the code uses when a variable is absent.
#
# A real environment variable always beats this file, so a container's
# orchestrator stays in charge. Copy, do not rename -- .env is gitignored,
# .env.example is committed.

# -- storage and data ------------------------------------------------------

# Where batch artifacts live. A directory, or s3://bucket/prefix.
RISK_GRID_STORE=./data

# Control plane. SQLite locally; Postgres deployed.
RISK_GRID_DATABASE_URL=sqlite+pysqlite:///./risk_grid.db

# Root for per-firm column templates and shock configs.
# RISK_GRID_TEMPLATES=~/.risk_grid

# Loaded batches held in memory per firm.
# RISK_GRID_BATCH_CACHE=3

# -- isolation -------------------------------------------------------------

# The ONE firm this process may serve. Unset means multi-firm, where the
# caller's own firm decides -- which is what you want on a laptop.
#
# Deployed, each container sets this, so a routing mistake cannot reach
# another firm's data even with valid credentials. Leave it unset for local
# development.
# RISK_GRID_FIRM=acme

# -- email -----------------------------------------------------------------

# Unset, reports and alerts print to the console instead of sending. That is
# deliberate: a report that appears to send and does not is worse than one
# that obviously did not.
# RISK_GRID_SMTP_HOST=smtp.example.com
# RISK_GRID_SMTP_PORT=587
# RISK_GRID_SMTP_USER=
# RISK_GRID_SMTP_PASSWORD=
# RISK_GRID_SMTP_SENDER=risk_grid <no-reply@example.com>
# RISK_GRID_SMTP_TLS=1

# -- misc ------------------------------------------------------------------

# Chromium for report screenshots, if it is not on the default path.
# RISK_GRID_CHROMIUM=/opt/pw-browsers/chromium

# Set by the test suite so a developer's .env cannot leak into a test run.
# RISK_GRID_NO_DOTENV=1
